@import "tailwindcss";

@layer base {
  :root {
    --font-syne: 'Syne', sans-serif;
    --font-inter: 'Inter', sans-serif;
  }

  body {
    font-family: var(--font-inter);
    background-color: #030305;
    color: #ffffff;
  }
}

.font-syne {
  font-family: 'Syne', sans-serif;
}

.font-syncopate {
  font-family: 'Syncopate', sans-serif;
  letter-spacing: 0.04em;
}

.font-unbounded {
  font-family: 'Unbounded', sans-serif;
}

.font-inter {
  font-family: 'Inter', sans-serif;
}

.font-jakarta {
  font-family: 'Plus Jakarta Sans', sans-serif;
}

/* Hide default scrollbars for pure slide-deck presentation look */
.no-scrollbar::-webkit-scrollbar {
  display: none;
}

.no-scrollbar {
  -ms-overflow-style: none;
  scrollbar-width: none;
}

/* Mobile vs Desktop CSS Scroll Snap Container Isolation */
@media (max-width: 767px) {
  html, body, #root, #presentation-viewport {
    overflow-y: auto !important;
    height: auto !important;
  }
  .slides-container {
    scroll-snap-type: none !important;
    overflow-y: visible !important;
    height: auto !important;
  }
  /* Slide 1 stays full screen, remaining slides have natural height with clean spacing */
  .slide-section {
    scroll-snap-align: none !important;
    height: auto !important;
    overflow: visible !important;
    padding-top: 4rem !important;
    padding-bottom: 4rem !important;
  }
  #slide-1-cover {
    height: 100dvh !important;
    min-height: 100dvh !important;
    padding-top: 2rem !important;
    padding-bottom: 2rem !important;
  }
}
@media (min-width: 768px) {
  .slides-container {
    scroll-snap-type: y mandatory;
    height: 100vh;
    overflow-y: scroll;
  }
  .slide-section {
    scroll-snap-align: start;
    height: 100vh;
    overflow: hidden;
  }
}

/* Subtle glow orb pulse keyframes */
@keyframes orb-pulse {
  0%,
  100% {
    transform: scale(1) translate(0px, 0px);
    opacity: 0.85;
  }

  50% {
    transform: scale(1.08) translate(15px, -10px);
    opacity: 1;
  }
}

@keyframes orb-float-alt {
  0%,
  100% {
    transform: scale(1.05) translate(-10px, 10px) rotate(0deg);
    opacity: 0.75;
  }

  50% {
    transform: scale(0.95) translate(20px, -15px) rotate(15deg);
    opacity: 0.95;
  }
}

.animate-orb {
  animation: orb-pulse 8s ease-in-out infinite;
}

.animate-orb-alt {
  animation: orb-float-alt 11s ease-in-out infinite;
}

/* Vignette edge mask */
.vignette-overlay {
  background: radial-gradient(circle at center, transparent 40%, rgba(3, 3, 5, 0.7) 85%, #030305 100%);
  pointer-events: none;
}

/* Infinite Marquee Scroll Animation */
@keyframes marquee-scroll {
  0% { transform: translate3d(0, 0, 0); }
  100% { transform: translate3d(-50%, 0, 0); }
}
.animate-marquee {
  display: flex;
  width: max-content;
  animation: marquee-scroll 24s linear infinite;
}
.animate-marquee:hover {
  animation-play-state: paused;
}
</file>

