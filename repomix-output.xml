    const container = document.getElementById('slides-container');
    const dynamicOrb = document.getElementById('dynamic-orb');
    const slide1Ribbon = document.getElementById('slide-1-ribbon');

    const orbPositions = [
      { left: '50%', top: '50%', width: '680px', height: '380px' },
      { left: '28%', top: '50%', width: '580px', height: '580px' },
      { left: '30%', top: '55%', width: '580px', height: '420px' },
      { left: '50%', top: '50%', width: '520px', height: '520px' },
      { left: '50%', top: '48%', width: '840px', height: '440px' },
      { left: '55%', top: '52%', width: '740px', height: '460px' },
      { left: '50%', top: '50%', width: '780px', height: '420px' },
      { left: '50%', top: '50%', width: '640px', height: '440px' }
    ];

    function goToSlide(index) {
      container.scrollTo({
        top: index * window.innerHeight,
        behavior: 'smooth'
      });
    }

    function handleHtmlPhotoUpload(input) {
      if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = function(e) {
          const img = document.getElementById('profile-img');
          if (img) img.src = e.target.result;
        };
        reader.readAsDataURL(input.files[0]);
      }
    }

    container.addEventListener('scroll', () => {
      const idx = Math.round(container.scrollTop / window.innerHeight);
      if (idx === 0) {
        if (slide1Ribbon) slide1Ribbon.style.opacity = '1';
        if (dynamicOrb) dynamicOrb.style.opacity = '0';
      } else {
        if (slide1Ribbon) slide1Ribbon.style.opacity = '0';
        if (dynamicOrb) dynamicOrb.style.opacity = '1';
      }

      if (orbPositions[idx] && dynamicOrb) {
        dynamicOrb.style.left = orbPositions[idx].left;
        dynamicOrb.style.top = orbPositions[idx].top;
        dynamicOrb.style.width = orbPositions[idx].width;
        dynamicOrb.style.height = orbPositions[idx].height;
      }
    });

    window.addEventListener('keydown', (e) => {
      const currentIdx = Math.round(container.scrollTop / window.innerHeight);
      if (e.key === 'ArrowDown' || e.key === 'PageDown' || e.key === ' ') {
        e.preventDefault();
        goToSlide(Math.min(7, currentIdx + 1));
      } else if (e.key === 'ArrowUp' || e.key === 'PageUp') {
        e.preventDefault();
        goToSlide(Math.max(0, currentIdx - 1));
      }
    });
  </script>
