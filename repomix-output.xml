        <div className="relative z-10 h-full flex flex-col justify-between p-3 sm:p-3.5 font-jakarta">
          {/* Top section */}
          <div className="flex items-start justify-between">
            <div className="relative">
              <motion.div
                className="relative"
                animate={{
                  opacity: isExpanded ? 0 : 1,
